#!/bin/bash
# pre-commit hook for web-quick-start-light
# Lightweight checks (< 2 seconds total)
#
# Install: cp scripts/pre-commit .git/hooks/pre-commit
# Or:      ln -s ../../scripts/pre-commit .git/hooks/pre-commit

set -e

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

has_error=0

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
    exit 0
fi

# ---------- Check 1: 禁止 @Data 注解（ArchUnit C-07） ----------
java_files=$(echo "$staged_files" | grep -E '\.java$' || true)

if [ -n "$java_files" ]; then
    data_violations=""
    while IFS= read -r file; do
        # Check staged content only
        content=$(git show ":${file}" 2>/dev/null || true)
        if echo "$content" | grep -qE '^\s*@Data\b'; then
            data_violations="${data_violations}\n  ${file}"
        fi
    done <<< "$java_files"

    if [ -n "$data_violations" ]; then
        echo -e "${RED}[DENIED] @Data annotation detected (ArchUnit C-07):${NC}"
        echo -e "$data_violations"
        echo -e "${YELLOW}Use @Builder + @RequiredArgsConstructor instead.${NC}"
        has_error=1
    fi
fi

# ---------- Check 2: 禁止 TODO/FIXME 提交 ----------
todo_violations=""
while IFS= read -r file; do
    # Skip this script itself (contains TODO/FIXME in comments/matching patterns)
    case "$file" in scripts/pre-commit) continue ;; esac
    content=$(git show ":${file}" 2>/dev/null || true)
    matches=$(echo "$content" | grep -nE '\b(TODO|FIXME)\b' || true)
    if [ -n "$matches" ]; then
        while IFS= read -r match; do
            todo_violations="${todo_violations}\n  ${file}:${match}"
        done <<< "$matches"
    fi
done <<< "$staged_files"

if [ -n "$todo_violations" ]; then
    echo -e "${RED}[DENIED] TODO/FIXME found in staged files:${NC}"
    echo -e "$todo_violations"
    echo -e "${YELLOW}Resolve or remove before committing.${NC}"
    has_error=1
fi

# ---------- Check 3: 禁止敏感文件提交 ----------
sensitive_patterns='\.env$|\.env\.|credentials|\.secret|\.pem$|\.key$|\.p12$|\.jks$|id_rsa|id_ed25519'
sensitive_violations=""

while IFS= read -r file; do
    if echo "$file" | grep -qE "$sensitive_patterns"; then
        sensitive_violations="${sensitive_violations}\n  ${file}"
    fi
done <<< "$staged_files"

if [ -n "$sensitive_violations" ]; then
    echo -e "${RED}[DENIED] Sensitive file detected in staging area:${NC}"
    echo -e "$sensitive_violations"
    echo -e "${YELLOW}These files may contain secrets. Remove from staging.${NC}"
    has_error=1
fi

# ---------- Result ----------
if [ "$has_error" -ne 0 ]; then
    echo ""
    echo -e "${YELLOW}Pre-commit checks failed. Fix the above issues or use --no-verify to skip.${NC}"
    exit 1
fi

echo -e "${GREEN}✓ Pre-commit checks passed${NC}"
exit 0
